<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>bot.wuliang</groupId>
        <artifactId>Tencent-Bot-Kotlin</artifactId>
        <version>2.4.1</version>
    </parent>

    <artifactId>wuliang-admin</artifactId>
    <description>wuliang主程序入口</description>

    <!-- 在admin模块的pom.xml中添加 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>

        <dependency>
            <groupId>bot.wuliang</groupId>
            <artifactId>wuliang-common</artifactId>
        </dependency>

        <dependency>
            <groupId>bot.wuliang</groupId>
            <artifactId>wuliang-warframe</artifactId>
        </dependency>

        <dependency>
            <groupId>bot.wuliang</groupId>
            <artifactId>wuliang-genshin</artifactId>
        </dependency>

        <!--小游戏模块-->
        <dependency>
            <groupId>bot.wuliang</groupId>
            <artifactId>wuliang-game</artifactId>
        </dependency>

        <!--天气模块-->
        <dependency>
            <groupId>bot.wuliang</groupId>
            <artifactId>wuliang-weather</artifactId>
        </dependency>

        <!--系统模块-->
        <dependency>
            <groupId>bot.wuliang</groupId>
            <artifactId>wuliang-system</artifactId>
        </dependency>

        <!--系统模块-->
        <dependency>
            <groupId>bot.wuliang</groupId>
            <artifactId>wuliang-adapter</artifactId>
        </dependency>

    </dependencies>

    <profiles>
        <!-- 根据部署平台裁剪驱动；不指定属性时保留完整驱动，方便 IDE 开发。 -->
        <profile>
            <id>playwright-platform</id>
            <activation>
                <property>
                    <name>playwright.platform</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <!-- 在上面的 Spring Boot repackage 完成后处理最终可执行 JAR。 -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>trim-playwright-driver</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>${project.basedir}/../scripts/TrimPlaywrightDriver.java</argument>
                                        <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                        <argument>${playwright.platform}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
